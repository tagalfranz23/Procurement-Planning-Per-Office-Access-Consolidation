# PPMP System â€” Environment Variables
# Copy to .env and fill in your values
# â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

# Flask (development defaults; set production secrets in the hosting dashboard)
FLASK_ENV=development
FLASK_DEBUG=1
FLASK_SECRET_KEY=change-this-to-a-random-secret-key
FLASK_PORT=5000
# Set only when initializing a new production database with no Admin account.
# INITIAL_ADMIN_PASSWORD=

# Node.js
NODE_PORT=3001

# Optional database override. By default, the app uses ppmp.sqlite beside app.py.
# Set a persistent writable SQLite path for deployment, or a MariaDB URL for recovery.
# DB_BACKEND=sqlite
# Set DB_BACKEND=mariadb to use the DB_* connection values below.
# DATABASE_URL=sqlite:////srv/ppmp/data/ppmp.sqlite
# DATABASE_URL=mysql+mysqlconnector://user:password@host:3306/ppmp_db
# Render PostgreSQL DATABASE_URL is normalized to the Psycopg 3 driver.
# DATABASE_URL=postgresql://user:password@host:5432/ppmp_db
# DB_BACKEND=postgresql

# MariaDB/PostgreSQL alternate connection settings (selected with DB_BACKEND)
# Set DB_PORT=5432 when DB_BACKEND=postgresql.
DB_HOST=localhost
DB_PORT=3306
DB_USER=ppmp_user
DB_PASSWORD=1234
DB_NAME=ppmp_db
